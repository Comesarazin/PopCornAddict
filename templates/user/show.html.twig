{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <h1>Profil de {{ user.nom }}</h1>

    {% if movies is not empty %}
        <h2>Films ajoutés</h2>
        <ul>
            {% for movie in movies %}
                <li>{{ movie.title }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if tvShows is not empty %}
        <h2>Séries ajoutées</h2>
        <ul>
            {% for tvShow in tvShows %}
                <li>{{ tvShow.name }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if filmFakers is not empty %}
        <h2>FilmFakers ajoutés</h2>
        <ul>
            {% for filmFaker in filmFakers %}
                <li>{{ filmFaker.title }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <a href="{{ path('app_user_index') }}">back to list</a>

    <a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>

    {{ include('user/_delete_form.html.twig') }}
{% endblock %}
